{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ev-charger.runasp.net/api/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "https://ev-charger.runasp.net/socket.io"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://ev-charger.runasp.net/socket.io/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
